generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STORE_MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  email        String     @unique @db.VarChar(254)
  name         String     @db.VarChar(120)
  passwordHash String     @db.VarChar(255)
  role         UserRole   @default(CUSTOMER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)
  addresses    Address[]
  cart         Cart?
  wishlist     Wishlist?
  orders       Order[]
  auditLogs    AuditLog[]
}

model Product {
  id          String              @id @default(cuid()) @db.VarChar(30)
  sku         String              @unique @db.VarChar(80)
  name        String              @db.VarChar(180)
  slug        String              @unique @db.VarChar(200)
  description String              @db.Text
  price       Decimal             @db.Decimal(10, 2)
  imageUrl    String              @db.VarChar(2048)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.DateTime(3)
  updatedAt   DateTime            @updatedAt @db.DateTime(3)
  categoryId  String              @db.VarChar(30)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory   Inventory?
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  orderItems  OrderItem[]
  collections CollectionProduct[]
  movements   InventoryMovement[]

  @@index([categoryId, active])
  @@index([name])
}

model Category {
  id        String    @id @default(cuid()) @db.VarChar(30)
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  products  Product[]
}

model Collection {
  id          String              @id @default(cuid()) @db.VarChar(30)
  name        String              @db.VarChar(120)
  slug        String              @unique @db.VarChar(140)
  description String              @db.Text
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.DateTime(3)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String     @db.VarChar(30)
  productId    String     @db.VarChar(30)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Campaign {
  id          String    @id @default(cuid()) @db.VarChar(30)
  name        String    @db.VarChar(120)
  description String    @db.Text
  discountPct Int       @default(0)
  startsAt    DateTime  @db.DateTime(3)
  endsAt      DateTime  @db.DateTime(3)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@index([active, startsAt, endsAt])
}

model Cart {
  id        String     @id @default(cuid()) @db.VarChar(30)
  userId    String     @unique @db.VarChar(30)
  updatedAt DateTime   @updatedAt @db.DateTime(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid()) @db.VarChar(30)
  cartId    String   @db.VarChar(30)
  productId String   @db.VarChar(30)
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

model Wishlist {
  id      String         @id @default(cuid()) @db.VarChar(30)
  userId  String         @unique @db.VarChar(30)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid()) @db.VarChar(30)
  wishlistId String   @db.VarChar(30)
  productId  String   @db.VarChar(30)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Order {
  id          String       @id @default(cuid()) @db.VarChar(30)
  userId      String       @db.VarChar(30)
  status      OrderStatus  @default(PENDING)
  subtotal    Decimal      @db.Decimal(10, 2)
  total       Decimal      @db.Decimal(10, 2)
  idempotencyKey String?   @unique @db.VarChar(100)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @db.DateTime(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payment     Payment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid()) @db.VarChar(30)
  orderId   String  @db.VarChar(30)
  productId String  @db.VarChar(30)
  name      String  @db.VarChar(180)
  sku       String  @db.VarChar(80)
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Inventory {
  productId String   @id @db.VarChar(30)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id        String   @id @default(cuid()) @db.VarChar(30)
  productId String   @db.VarChar(30)
  change    Int
  reason    String   @db.VarChar(200)
  actorId   String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

model Address {
  id         String   @id @default(cuid()) @db.VarChar(30)
  userId     String   @db.VarChar(30)
  recipient  String   @db.VarChar(120)
  line1      String   @db.VarChar(180)
  line2      String?  @db.VarChar(180)
  city       String   @db.VarChar(100)
  region     String   @db.VarChar(100)
  postalCode String   @db.VarChar(20)
  country    String   @db.VarChar(2)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id          String        @id @default(cuid()) @db.VarChar(30)
  orderId     String        @unique @db.VarChar(30)
  status      PaymentStatus @default(PENDING)
  providerRef String?       @db.VarChar(180)
  amount      Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @db.DateTime(3)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(30)
  actorId   String?  @db.VarChar(30)
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
